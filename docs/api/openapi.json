{
  "components": {
    "schemas": {
      "AdmissionBody": {
        "additionalProperties": false,
        "description": "Тело POST /v1/operations/authorize: удостоверение «Мандата» и запрос операции.",
        "properties": {
          "credential": {
            "additionalProperties": true,
            "title": "Credential",
            "type": "object"
          },
          "operation_risk": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "уровень риска: payment, high, low…",
            "title": "Operation Risk"
          },
          "request": {
            "$ref": "#/components/schemas/AdmissionOperation"
          }
        },
        "required": [
          "credential",
          "request"
        ],
        "title": "AdmissionBody",
        "type": "object"
      },
      "AdmissionOperation": {
        "additionalProperties": false,
        "description": "Запрос одной операции, к которому привязано удостоверение. ИНН представителя в журнал не пишется.",
        "properties": {
          "amount_rub": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "целые рубли",
            "title": "Amount Rub"
          },
          "audience": {
            "description": "система банка, для которой выпущено удостоверение",
            "maxLength": 200,
            "minLength": 1,
            "title": "Audience",
            "type": "string"
          },
          "nonce": {
            "description": "одноразовый номер запроса",
            "maxLength": 200,
            "minLength": 16,
            "title": "Nonce",
            "type": "string"
          },
          "operation": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Operation",
            "type": "string"
          },
          "operation_date": {
            "description": "день операции по Москве",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Operation Date",
            "type": "string"
          },
          "organization_inn": {
            "pattern": "^\\d{10}(\\d{2})?$",
            "title": "Organization Inn",
            "type": "string"
          },
          "representative_inn": {
            "pattern": "^\\d{10}(\\d{2})?$",
            "title": "Representative Inn",
            "type": "string"
          }
        },
        "required": [
          "organization_inn",
          "operation",
          "operation_date",
          "representative_inn",
          "audience",
          "nonce"
        ],
        "title": "AdmissionOperation",
        "type": "object"
      },
      "EraseBody": {
        "additionalProperties": false,
        "description": "Тело POST /v1/cases/{id}/erase: основание удаления из закрытого списка.",
        "properties": {
          "reason": {
            "enum": [
              "unlawful_processing",
              "purpose_achieved",
              "consent_withdrawn",
              "subject_request"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "EraseBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReviewAction": {
        "description": "Действие разбора. ``expected_version`` — поле ``version`` из GET /v1/cases/{id}/review.",
        "properties": {
          "expected_version": {
            "minimum": 0.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "reason": {
            "default": "",
            "maxLength": 4000,
            "title": "Reason",
            "type": "string"
          },
          "specialization": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialization"
          }
        },
        "required": [
          "expected_version"
        ],
        "title": "ReviewAction",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Мандат API"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/readyz": {
      "get": {
        "description": "Готовность (не живость): журнал, хранилище, ключи. 200 только если все проверки прошли.\n\nВ теле только имена проверок и ok/fail, без путей и текстов исключений. Это проверка конфигурации и\nдоступности на момент запроса, а не гарантия сохранности данных.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz"
      }
    },
