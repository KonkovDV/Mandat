    "/v1/operations/authorize": {
      "post": {
        "description": "Допуск одной операции по удостоверению: подлинность, статус, вердикт confirmed и привязка к запросу.\n\n200 — решение: ``allowed`` и причины отказа. Отказ тоже 200: это ответ, а не ошибка запроса.\n``already_admitted`` — этот же запрос уже допущен в ``admitted_at``, например ответ потерялся в сети;\nвторого допуска нет, операцию по первому допуску ДБО проводит один раз.\n503 — допуск не настроен или в защищённом режиме нет общего хранилища nonce и журнала.",
        "operationId": "authorize_operation_v1_operations_authorize_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdmissionBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Authorize Operation V1 Operations Authorize Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Authorize Operation"
      }
    },
