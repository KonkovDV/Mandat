    "/v1/cases/{case_id}/review/{action}": {
      "post": {
        "description": "Действие разбора: appeal, open, accept, reject, request_docs, close, require (docs/REVIEW.md).\n\n403 — роль, специализация или независимость решения; 409 — переход недопустим или версия устарела;\n422 — нет основания; 503 — журнал не настроен в pilot/prod или хранилище недоступно.",
        "operationId": "review_action_v1_cases__case_id__review__action__post",
        "parameters": [
          {
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "title": "Case Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "action",
            "required": true,
            "schema": {
              "title": "Action",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Review Action V1 Cases  Case Id  Review  Action  Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Review Action"
      }
    },
    "/v1/events": {
      "post": {
        "description": "Только оценка событий. Статусы удостоверений этот метод не меняет: их пишет CLI monitor.",
        "operationId": "post_events_v1_events_post",
        "parameters": [
          {
            "in": "query",
            "name": "window_hours",
            "required": false,
            "schema": {
