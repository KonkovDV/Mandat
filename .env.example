# Скопируйте в .env и задайте свои значения. .env в репозиторий не кладётся.

# Доступ к HTTP API: задайте токен или пользователей. Без обоих mandat serve не стартует.
# Токен режима стенда.
MANDAT_API_TOKEN=
# Пользователи API: JSON-массив или путь к файлу. Строку для каждого печатает mandat api-user.
MANDAT_API_USERS=
# 1 включает Swagger на /docs. Вне стенда лучше не включать.
MANDAT_API_DOCS=
# Запросов в минуту с одного адреса. 0 снимает ограничение.
MANDAT_API_RATE_PER_MIN=120
# Где лежат лимит и отчёты: memory, sqlite:///var/api.db (несколько воркеров), redis://host:6379/0.
MANDAT_API_STORE=

# Обязателен для docker compose. demo, dev, test или pilot, prod.
# В pilot и prod mandat serve не стартует без MANDAT_JOURNAL_KEY и MANDAT_PII_KEY.
MANDAT_ENV=demo

# Ключ HMAC журнала решений. Пусто — журнал без HMAC (только хеш-цепочка).
MANDAT_JOURNAL_KEY=

# Ключ псевдонимизации ПДн. Пусто — ключ разработки, только для демо.
MANDAT_PII_KEY=

# Секрет подписи событий мониторинга (Standard Webhooks), whsec_… из mandat webhook-secret.
# Для смены ключа: новый и старый через пробел, новый первым. Пусто — подпись не ставится.
# Доставку в антифрод делает адаптер банка; ядро HTTP не отправляет.
MANDAT_WEBHOOK_SECRET=

# Модель-советник. Пусто — модель выключена.
MANDAT_LLM_BASE_URL=
MANDAT_LLM_MODEL=local-model
MANDAT_LLM_API_KEY=
MANDAT_LLM_ALLOWED_HOSTS=127.0.0.1,localhost
